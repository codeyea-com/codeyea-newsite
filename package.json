{
  "name": "codeyea",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "db:start": "tsx scripts/local-db.ts",
    "db:migrate": "prisma generate && prisma migrate deploy",
    "db:seed": "tsx scripts/seed.ts",
    "setup:local": "tsx scripts/setup-local.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "test": "tsx scripts/run-tests.ts",
    "test:e2e": "tsx scripts/run-tests.ts browser",
    "sessions:revoke": "tsx scripts/revoke-sessions.ts",
    "test:setup": "tsx scripts/test-setup.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@fontsource/josefin-sans": "^5.3.0",
    "@netlify/blobs": "^11.1.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-auth": "^1.7.4",
    "dotenv": "^17.4.2",
    "embla-carousel-react": "8.6.0",
    "flickity": "^2.3.0",
    "gsap": "3.15.0",
    "next": "^16.3.4",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "0.35.5",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/flickity": "^2.2.12",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "mysql2": "^3.24.0"
  }
}
