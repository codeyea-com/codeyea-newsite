DATABASE_URL= # Runtime connection; use the Neon pooled URL on Vercel.
DIRECT_URL= # Direct Neon URL for Prisma migrations and schema tools.
# Automatically provided after connecting a private Vercel Blob store to the project.
BLOB_READ_WRITE_TOKEN=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
EXTERNAL_STOCK_SEARCH_ENABLED=false

# Lead notification delivery (server only; verified sender required)
RESEND_API_KEY=
RESEND_FROM=

# Cloudflare Turnstile: the site key is public; the secret stays server-side.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=
# Analytics and reporting (server-only tokens)
GA4_PROPERTY_ID=
GOOGLE_ACCESS_TOKEN=
GSC_SITE_URL=
GTM_CONTAINER_ID=
CLARITY_PROJECT_ID=
CLARITY_API_TOKEN=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Enable only after launch approval and final SEO checks.
SITE_INDEXING_ENABLED=false
