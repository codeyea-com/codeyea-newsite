    ".lqd-fb-style-1 h3 { font-size: 16px; line-height: 1.625em; }",
    ".lqd-fb-style-1 h2 { font-size: 33px; }",
    ".lqd-fb-style-1 .lqd-fb-bg { background: linear-gradient(to top, rgba(0, 0, 0, 0.7) 0%, transparent 50%); }",
