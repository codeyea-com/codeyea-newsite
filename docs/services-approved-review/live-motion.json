    ".lqd-fb-style-1.is-in-view .lqd-fb-img, .lqd-fb-style-2.is-in-view .lqd-fb-img { opacity: 1; transform: scale(1); }",
    ".lqd-fb-style-1 { transition: transform 0.85s cubic-bezier(0.15, 0.95, 0.4, 1), box-shadow 0.3s; }",
    ".lqd-fb-style-1 h6, .lqd-fb-style-1 h3, .lqd-fb-style-1 h2 { color: rgb(255, 255, 255); }",
