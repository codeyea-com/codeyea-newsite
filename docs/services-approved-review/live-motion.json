    ".lqd-fb [data-split-text=\"true\"] .split-inner { display: inline-block; }",
    ".lqd-fb:hover .lqd-fb-hover-overlay { opacity: 1; }",
    ".lqd-fb-img figure { width: 100%; background-size: cover; background-position: center center; background-repeat: no-repeat; }",
