    ".lqd-fb-style-1-3 h6::after { content: \"\"; display: inline-block; width: 11.5%; height: 0.15em; position: absolute; bottom: 0px; left: 0px; background-color: currentcolor; }",
    ".lqd-fb-style-1-3 p { font-size: 16px; line-height: 1.5em; color: rgba(255, 255, 255, 0.55); }",
    ".lqd-fb-style-2 h2 { font-size: 24px; color: rgb(255, 255, 255); }",
    ".lqd-fb-style-2 .lqd-fb-bg { background-color: rgba(0, 0, 0, 0.2); opacity: 0; transition: opacity 0.3s; }",
    ".lqd-fb-style-2 .element-uncovered .lqd-fb-bg { opacity: 1; }",
    ".lqd-fb-style-3 h2, .lqd-fb-style-3 h6 { color: rgb(255, 255, 255); }",
