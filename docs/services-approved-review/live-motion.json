    ".lqd-fb-zoom-img-onhover:hover .lqd-fb-img figure { transition-duration: 7s; transform: scale(1.2); }",
    ".lqd-fb-style-1 .lqd-fb-img, .lqd-fb-style-2 .lqd-fb-img { opacity: 0; transform: scale(1.075); transition: transform 0.65s, opacity 0.65s; }",
