  "rules": [
    ".iconbox-contents-show-onhover.iconbox-bubble .contents { position: absolute; top: 100%; left: 50%; z-index: 10; opacity: 0; visibility: hidden; transform: translate(-50%, 5%); transition: transform 0.65s cubic-bezier(0.165, 0.84, 0.44, 1), opacity, 0.65s, visibility 0.65s; }",
